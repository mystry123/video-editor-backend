# ===========================================
# APP CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=3000
# Public base URL of this API (required in production). Render links are
# <PUBLIC_API_URL>/r/<id>?t=<token>.
PUBLIC_API_URL=https://api.example.com

# Frontend URL (for OAuth redirects and CORS)
FRONTEND_URL=http://localhost:5173

# CORS Origins (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ===========================================
# DATABASE
# ===========================================
MONGODB_URI=mongodb://localhost:27017/video-editor
REDIS_URL=redis://localhost:6379

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-64-chars-recommended
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-64-chars

# Token expiration times
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# GOOGLE OAUTH
# ===========================================
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create a project
# 2. Configure OAuth consent screen
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add authorized redirect URI: http://localhost:3000/api/v1/auth/google/callback

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ===========================================
# APPLE OAUTH
# ===========================================
# Get from: https://developer.apple.com/account/resources/identifiers
# 1. Create App ID with Sign In with Apple capability
# 2. Create Service ID (this is your client ID)
# 3. Create Key with Sign In with Apple capability
# 4. Download .p8 key file

APPLE_CLIENT_ID=com.yourcompany.yourapp.service
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
# Paste .p8 file contents (replace newlines with \n)
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
APPLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/apple/callback

# ===========================================
# FACEBOOK OAUTH
# ===========================================
# Get from: https://developers.facebook.com/apps
# 1. Create App (Consumer type)
# 2. Add Facebook Login product
# 3. Set Valid OAuth Redirect URIs

FACEBOOK_APP_ID=your-app-id
FACEBOOK_APP_SECRET=your-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/facebook/callback

# ===========================================
# PROVIDERS
# ===========================================
# Where media and render outputs are stored: gcs (default) or s3
STORAGE_PROVIDER=gcs
# Where renders run: local (default; @remotion/renderer on the worker) or
# lambda (Remotion Lambda on AWS)
RENDER_PROVIDER=local
# The AWS choices (s3, lambda) refuse to start when their settings below are
# incomplete; the defaults only warn.

# ===========================================
# STORAGE: GOOGLE CLOUD STORAGE (STORAGE_PROVIDER=gcs)
# ===========================================
# Credentials come from Application Default Credentials, never key files:
# on the VM, its service account; locally run
#   gcloud auth application-default login \
#     --impersonate-service-account=<service-account>@<project>.iam.gserviceaccount.com
# (signed upload/download URLs need a service account to sign with).
GCP_PROJECT_ID=your-gcp-project
# Uploads and generated media (publicly readable)
GCS_MEDIA_BUCKET=your-media-bucket
# Render outputs made on the worker (private; served through signed URLs)
GCS_RENDERS_BUCKET=your-renders-bucket

# ===========================================
# STORAGE: AMAZON S3 (STORAGE_PROVIDER=s3)
# ===========================================
# AWS_REGION=us-east-1
# Optional: without keys the AWS SDK's default credential chain is used
# (an instance role, AWS_PROFILE, ...).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Uploads and generated media (publicly readable, or behind CDN_URL)
# S3_BUCKET=your-media-bucket
# Render outputs made on the worker (private), needed with RENDER_PROVIDER=local
# S3_RENDERS_BUCKET=your-renders-bucket

# Public base URL for media. Defaults to the media bucket's own URL
# (https://storage.googleapis.com/<GCS_MEDIA_BUCKET> or
# https://<S3_BUCKET>.s3.<AWS_REGION>.amazonaws.com); set it when a CDN sits in front.
CDN_URL=

# ===========================================
# RENDERS: ON THE WORKER (RENDER_PROVIDER=local)
# ===========================================
# The composition bundle (frontend app/remotion). On the server the frontend
# deploy builds /var/www/shotline/remotion-bundles/<sha> and points `current`
# at it. Locally: in video-editor-frontend run
#   pnpm exec remotion bundle app/remotion/index.tsx --out-dir ../remotion-bundle
# and point this at that directory.
REMOTION_SERVE_URL=/var/www/shotline/remotion-bundles/current
# Renders one worker runs at once (each uses every core it gets).
RENDER_CONCURRENCY=1
# Browser tabs per render; empty = Remotion's default (half the cores).
REMOTION_CONCURRENCY=
# Renders still running after this many minutes are stopped and failed.
RENDER_DEADLINE_MINUTES=45

# ===========================================
# RENDERS: REMOTION LAMBDA (RENDER_PROVIDER=lambda)
# ===========================================
# Needs a Remotion Lambda function and a Remotion site deployed in your AWS
# account (npx remotion lambda functions deploy / sites create). Outputs are
# private objects in REMOTION_BUCKET, served through signed URLs.
# AWS_REGION=us-east-1
# REMOTION_FUNCTION_NAME=remotion-render-4-0-400-mem3008mb-disk2048mb-240sec
# REMOTION_BUCKET=remotionlambda-useast1-xxxxxxxxxx
# With Lambda, REMOTION_SERVE_URL is the site's https URL:
# REMOTION_SERVE_URL=https://remotionlambda-useast1-xxxxxxxxxx.s3.us-east-1.amazonaws.com/sites/shotline/index.html
# Keys for Remotion (or set AWS_ACCESS_KEY_ID/SECRET, or AWS_PROFILE)
# REMOTION_AWS_ACCESS_KEY_ID=
# REMOTION_AWS_SECRET_ACCESS_KEY=
# Most Lambdas one render may use at once (keep under the account's concurrency limit)
# REMOTION_MAX_LAMBDAS=8
# Webhook mode (recommended): Remotion calls POST /api/v1/webhooks/remotion when
# a render ends, signed with the secret. Without both, workers poll Lambda.
# REMOTION_WEBHOOK_URL=https://api.example.com/api/v1/webhooks/remotion
# REMOTION_WEBHOOK_SECRET=

# ===========================================
# ELEVENLABS (Transcription)
# ===========================================
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Text to speech provider: elevenlabs (default) or sarvam
TTS_PROVIDER=elevenlabs
# Sarvam API subscription key (dashboard.sarvam.ai), when TTS_PROVIDER=sarvam
SARVAM_API_KEY=

# ===========================================
# EMAIL (SMTP)
# ===========================================
# Examples:
# SendGrid: smtp.sendgrid.net, port 587, user "apikey", pass is your API key
# AWS SES: email-smtp.us-east-1.amazonaws.com, port 587
# Gmail: smtp.gmail.com, port 587 (use App Password)

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=noreply@yourdomain.com

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info

# Shared secret with the Remix server (same variable in the frontend env).
# Lets the API rate-limit server-side calls by the browser's IP instead of
# the Remix server's. At least 32 characters, e.g. `openssl rand -hex 32`.
INTERNAL_PROXY_SECRET=

# AI reframe engine v2 (shotline-reframe service). When set, AI reframe uses it
# instead of the YOLO service. The token must match the service's
# REFRAME_SERVICE_TOKEN; the service's REFRAME_ALLOWED_HOSTS must include the
# CDN host videos are served from.
REFRAME_SERVICE_URL=http://localhost:8090
REFRAME_SERVICE_TOKEN=
